# pylint configuration for newsprism.
#
# The goal here is not to chase a 10/10 score by silencing everything, but to
# switch off a small set of checks that would actively push the code towards
# worse design for this specific project - a single-file, long-running data
# pipeline - and to make the score reproducible regardless of which optional
# dependencies happen to be installed.

[MAIN]
# Optional / heavy third-party deps that aren't always installed in a linting
# environment. Listing them here prevents spurious import-error (E0401) reports
# that would otherwise make the score depend on the machine pylint runs on.
# fastembed is a genuinely optional import (guarded by try/except) in the code.
ignored-modules=
    fastembed,
    cohere,
    anthropic,
    sklearn,
    scipy,
    numpy,
    requests,
    yaml

[FORMAT]
# Slightly wider than the default 100 is not desired; we keep 100 but allow the
# handful of long URL/format lines that don't benefit from wrapping.
max-line-length=100

[DESIGN]
# This is a data pipeline: the main loop and run_once legitimately have many
# local variables, branches and statements. Splitting them purely to satisfy a
# counter would scatter tightly-coupled logic across helpers for no real gain.
max-locals=25
max-branches=20
max-statements=70
max-args=8
max-attributes=12

[MESSAGES CONTROL]
disable=
    # Broad `except Exception` is deliberate: a single failing feed, LLM call or
    # cache write must never crash the long-running scheduler loop. Each such
    # site logs and degrades gracefully on purpose.
    broad-exception-caught,

    # Several imports are intentionally function-local: either optional deps
    # loaded lazily, or stdlib modules (http.server, OrderedDict) only needed on
    # one code path, to keep startup light.
    import-outside-toplevel,

    # The HTTP handler methods must be named do_GET / do_POST (required by
    # BaseHTTPRequestHandler); they can't follow snake_case.
    invalid-name,

    # A few small internal handlers (HTTP request handler, signal handler) don't
    # each need a docstring; the module and public functions are documented.
    missing-class-docstring,
    missing-function-docstring,

    # The scheduler uses a handful of module-level globals (config reload,
    # last-run marker) shared with the signal handler by design.
    global-statement,

    # Signal handlers must accept (signum, frame) even when unused.
    unused-argument,
