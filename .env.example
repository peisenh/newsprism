# Copy to .env and fill in: cp .env.example .env
# .env is gitignored and holds ALL secrets (none of them in config.yaml).

# --- Reader (FreshRSS / Miniflux) ---
# Referenced from config.yaml via username_env/password_env (or api_token_env).
# FreshRSS: the API password from Profile -> API management (not the login password).
FRESHRSS_USER=freshrss
FRESHRSS_PASS=
# Miniflux instead:
# MINIFLUX_TOKEN=

# --- LLM (cluster labels, hotspots) - Anthropic Claude ---
ANTHROPIC_API_KEY=

# --- Embeddings - one of these depending on the provider in config.yaml ---
# Cohere (cross-lingual, recommended)
COHERE_API_KEY=
# or OpenAI-compatible
# OPENAI_API_KEY=

# --- Traefik BasicAuth for the refresh button (optional) ---
# Generate hash: htpasswd -nb user password
# IMPORTANT: double every $ in the hash to $$ here (otherwise docker compose
# interprets it as a variable). Example:
#   htpasswd output:   user:$apr1$abc$def...
#   enter here:        user:$$apr1$$abc$$def...
# NPREF_BASICAUTH=user:$$apr1$$REPLACE$$WITH$$HASH
